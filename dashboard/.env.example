# Dashboard configuration.
#
# These variables are read ONLY on the Next.js server (the API proxy route at
# src/app/api/[...path]/route.ts). They are intentionally NOT prefixed with
# NEXT_PUBLIC_, so Next.js never bundles them into client-side JavaScript.

# Base URL of the backend evaluation API (server-to-server).
API_URL=http://localhost:8000

# API key the dashboard uses to authenticate to the backend.
# Server-side only — NEVER prefix this with NEXT_PUBLIC_ (that would leak the key
# to every browser). Generate one with the backend (see docs/security.md), e.g.
# via POST /api/v1/auth/keys or the scripts/ helper.
#
# In development the backend permits unauthenticated access, so this may be left
# blank. In production it MUST be set to a valid key or all API calls return 401.
EVAL_API_KEY=
